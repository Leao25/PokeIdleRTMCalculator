{
  "name": "idledeck",
  "productName": "IdleDeck",
  "version": "1.2.1",
  "description": "IdleDeck (by Leão): até 4 contas de jogos idle de navegador numa janela só.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "teste": "electron . --teste",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "io.pokeidle.hub.pessoal",
    "productName": "IdleDeck",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "src/icone.png"
    },
    "portable": {
      "artifactName": "IdleDeck.exe"
    },
    "directories": {
      "output": "dist"
    },
    "electronVersion": "33.2.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
